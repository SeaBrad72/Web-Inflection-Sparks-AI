# Copy to .env.local for local development. Never commit real values.

# Required by /api/contact and /api/notify (Resend transactional email).
# Without this set, both endpoints return HTTP 500 on submit.
RESEND_API_KEY=

# Optional. Overrides the recipient address for contact/notify emails.
# Defaults to bradley@inflectionsparksolutions.com when unset.
CONTACT_EMAIL=

# Optional. Set to "true" to expose the Sanity Studio at /studio locally.
# Any other value (or unset) returns a 404 for that route.
ENABLE_STUDIO=
